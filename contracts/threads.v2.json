    "trending": "trending_up",
    "active_now": "bolt",
    "resolved": "check_circle"
  },
  "momentumPulse": {
    "new": { "tone": "neutral", "label": "New discussion" },
    "picking_up": { "tone": "purple", "label": "Gaining momentum" },
    "trending": { "tone": "purple", "label": "Trending discussion" },
    "active_now": { "tone": "orange", "label": "Active debate" },
    "resolved": { "tone": "green", "label": "Resolved" },
    "followed_participant": { "tone": "blue", "label": "Someone you follow joined" },
    "mention": { "tone": "blue", "label": "You were mentioned" },
    "helpful": { "tone": "green", "label": "Helpful answer" }
  },
  "momentumThresholds": {
    "newMaxAgeHours": 24,
    "pickingUp": {
      "minRepliesInWindow": 5,
      "windowHours": 6,
      "minUniqueParticipants": 3
    },
    "trending": {
      "minRepliesInWindow": 12,
      "windowHours": 24,
      "minUniqueParticipants": 8,
      "minSavesInWindow": 3
    },
    "activeNow": {
      "minRepliesInWindow": 3,
      "windowMinutes": 30,
      "minUniqueParticipants": 2
    },
    "resolvedOverridesMomentum": true,
    "calculationOwner": "server",
    "clientsMustNotInventMomentum": true
  },
  "reactionTypes": [
    "helpful",
    "relatable",
    "great_idea",
    "congratulations",
    "agree",
    "different_take"
