    "feedback_request": ["helpful", "great_idea", "relatable"],
    "creator_win": ["congratulations", "relatable", "great_idea", "helpful"],
    "debate": ["agree", "different_take", "helpful", "relatable"],
    "collaboration": ["helpful", "great_idea", "relatable"],
    "build_in_public": ["helpful", "relatable", "great_idea", "congratulations"]
  },
  "reactionTargetTypes": ["thread", "reply"],
  "legacyReactionAliases": {
