  "tippyStarterPresets": [
    {
      "id": "ask_feedback",
      "label": "Ask for feedback",
      "threadType": "feedback_request",
      "defaultCategoryId": "video_feedback",
      "prompt": "What are you working on?",
      "structure": [
        "What I’m trying to do",
        "What I’ve tried",
        "Where I’m stuck"
      ]
    },
    {
      "id": "share_win",
      "label": "Share a win",
      "threadType": "creator_win",
      "defaultCategoryId": "growth",
      "prompt": "What happened?",
      "structure": [
        "The result",
        "What changed",
        "What others can learn"
      ]
    },
    {
      "id": "start_debate",
      "label": "Start a debate",
      "threadType": "debate",
      "defaultCategoryId": "creator_life",
      "prompt": "What should creators weigh in on?",
      "structure": [
        "The question",
        "Position A",
        "Position B"
      ]
    },
    {
      "id": "get_help",
      "label": "Get help",
      "threadType": "question",
      "defaultCategoryId": "growth",
      "prompt": "What do you need help with?",
      "structure": [
        "The question",
        "Context",
        "What you already tried"
      ]
    },
    {
      "id": "post_update",
      "label": "Post an update",
      "threadType": "build_in_public",
      "defaultCategoryId": "content_ideas",
      "prompt": "What are you building?",
      "structure": [
        "Project",
        "This week’s update",
        "What’s next"
      ]
    }
  ],
