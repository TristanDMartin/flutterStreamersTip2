    "newWritesTarget": "threads",
    "legacyWritesAllowedUntil": "cutover_flag_threads_v2_writes_only",
    "projectionSets": {
      "type": "legacyDefaultType or inferred from tags",
      "momentumState": "server_or_adapter_using_momentumThresholds",
      "status": "legacyStatusAliases",
      "categoryId": "legacyCategoryAliases or passthrough id"
    }
  },
  "cutoverCriteria": [
    "All create/react/resolve/list paths use repositoryMethods",
    "Web and Flutter counters match for same threadId",
    "Momentum computed only by calculationOwner=server",
    "Backfill script forumPosts→threads completed for non-deleted posts",
    "Feature flag threads_v2_reads enabled in production for both clients",
    "Legacy client write paths gated off",
