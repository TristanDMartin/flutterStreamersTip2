{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamerstip.com/contracts/threads.v2.json",
  "title": "StreamersTip Creator Threads Contract v2",
  "description": "Single source of truth for website + Flutter Creator Threads. Typed threads, reactions, resolution, momentum, feed modules, Tippy, gamification, analytics. Legacy forumPosts are adapter-only until cutover.",
  "version": "2.0.0",
  "productName": "Creator Threads",
  "productSubtitle": "Ask questions, share what’s working, and build alongside other creators.",
  "canonicalPaths": {
    "threads": "threads/{threadId}",
    "replies": "threads/{threadId}/replies/{replyId}",
    "reactions": "threads/{threadId}/reactions/{reactionId}",
    "participants": "threads/{threadId}/participants/{userId}",
    "resolutions": "threads/{threadId}/resolution",
    "categories": "threadCategories/{categoryId}",
    "categoryFollows": "threadCategoryFollows/{userId}_{categoryId}",
    "interestSignals": "threadInterestSignals/{signalId}",
    "tippySummaries": "threads/{threadId}/tippySummary",
    "legacyForumPosts": "forumPosts/{postId} (dual-read adapter until cutover)",
    "legacyComments": "forumPosts/{postId}/comments/{commentId}",
    "legacyThreadFollows": "threadFollows/{postId}_{userId}",
    "legacyForumNotifications": "forumNotifications/{id}",
    "idLinks": {
      "legacyPostIdEqualsThreadId": "Backfill keeps the same document id when projecting forumPosts → threads",
      "reactionId": "{targetType}_{targetId}_{userId}_{reactionType}"
    }
  },
  "schemaVersion": 2,
  "threadTypes": [
    "question",
    "feedback_request",
    "creator_win",
    "debate",
    "collaboration",
    "build_in_public"
  ],
  "threadTypeLabels": {
    "question": "Ask a question",
    "feedback_request": "Request feedback",
    "creator_win": "Share a win",
    "debate": "Start a debate",
    "collaboration": "Find collaborators",
    "build_in_public": "Post an update"
  },
  "threadTypePayloads": {
    "question": ["question", "context", "tried", "platform", "mediaUrls"],
    "feedback_request": ["artifactType", "focusAreas", "context", "mediaUrls"],
    "creator_win": ["whatHappened", "whatContributed", "lesson"],
    "debate": ["prompt", "positions"],
    "collaboration": ["roleNeeded", "availability", "platform", "niche"],
    "build_in_public": ["projectName", "updateBody", "dayNumber", "mediaUrls"]
  },
