<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback splash screen with logo only (use this if composite image is not available) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Purple background -->
    <item>
        <color android:color="#6137EB" />
    </item>
    <!-- White logo centered -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>

