<?xml version="1.0" encoding="utf-8"?>
<!-- Custom splash screen drawable with logo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Purple background -->
    <item>
        <color android:color="#6137EB" />
    </item>
    <!-- White logo centered, positioned slightly above center - 192x192px -->
    <item
        android:width="192dp"
        android:height="192dp"
        android:gravity="center"
        android:top="-96dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>

