# Copy to .dev.vars for local development (do not commit .dev.vars)
# Firebase — same as wrangler secrets + wrangler [vars] FIREBASE_PROJECT_ID
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
# FIREBASE_SERVICE_ACCOUNT_JSON must be the full JSON string on one line
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
MUX_WEBHOOK_SECRET=your_webhook_signing_secret
