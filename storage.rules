rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Validate the incoming object only (never the existing one — overwrite bypass).
    function isValidImageType() {
      return request.resource != null &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }
    
    function isValidVideoType() {
      return request.resource != null &&
        request.resource.contentType.matches('video/(mp4|webm|mov|quicktime|avi)');
    }
    
    function isValidAudioType() {
      return request.resource != null &&
        request.resource.contentType.matches('audio/(mp3|mpeg|wav|ogg|m4a|mp4)');
    }
    
    function isValidDocumentType() {
      return request.resource != null &&
        request.resource.contentType.matches('application/(pdf|msword)|text/plain');
    }
    
    function isValidFileSize(maxSizeBytes) {
      return request.resource != null && request.resource.size <= maxSizeBytes;
    }
    
    // User avatars - root level (mobile app structure)
    // NEW format: avatars/{userId}/{fileName}
    match /avatars/{userId}/{fileName} {
      allow read: if true; // Public read for avatars
      allow create, update: if hasVerifiedEmail() && isOwner(userId) && 
        isValidImageType() && 
        isValidFileSize(5 * 1024 * 1024); // 5MB max
      allow delete: if hasVerifiedEmail() && isOwner(userId);
    }
    
    // User avatars - OLD format (backwards compatibility for existing files)
    // OLD format: avatars/{userId}_{timestamp}.jpg
    // This catch-all matches any file in avatars/ that doesn't match the new format
    // Allows read access to old format files (for backwards compatibility)
    // Prevents new uploads in old format (write: false)
    match /avatars/{allSegments} {
      allow read: if true; // Public read for old format avatars (backwards compatibility)
      allow write: if false; // No new uploads in old format - use new format only
    }
    
    // User avatars - nested structure (website structure)
    match /users/{userId}/avatars/{fileName} {
      allow read: if true; // Public read for avatars
      allow create, update: if hasVerifiedEmail() && isOwner(userId) && 
        isValidImageType() && 
        isValidFileSize(5 * 1024 * 1024); // 5MB max
      allow delete: if hasVerifiedEmail() && isOwner(userId);
    }
    
    // User profile images
    match /users/{userId}/images/{fileName} {
      allow read: if true; // Public read
      allow create, update: if hasVerifiedEmail() && isOwner(userId) && 
        isValidImageType() && 
        isValidFileSize(10 * 1024 * 1024); // 10MB max
      allow delete: if hasVerifiedEmail() && isOwner(userId);
    }
    
    // User videos (nested structure) — owner-only; public playback is via Mux CDN
    match /users/{userId}/videos/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if hasVerifiedEmail() && isOwner(userId) && 
        isValidVideoType() && 
        isValidFileSize(500 * 1024 * 1024); // 500MB max
      allow delete: if hasVerifiedEmail() && isOwner(userId);
    }
    
    // Videos collection (root level - for web uploads)
    // Allow authenticated users to upload/delete to their own videos folder
    // Note: Server-side uploads using Admin SDK bypass these rules
    match /videos/{userId}/{videoId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if hasVerifiedEmail() && 
        request.auth.uid == userId &&
        (isValidVideoType() || isValidImageType()) && 
        isValidFileSize(500 * 1024 * 1024); // 500MB max for videos, 10MB for thumbnails
      allow delete: if hasVerifiedEmail() && request.auth.uid == userId; // Explicit delete permission
    }
    
    // User audio files
    match /users/{userId}/audio/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if hasVerifiedEmail() && isOwner(userId) && 
        isValidAudioType() && 
        isValidFileSize(50 * 1024 * 1024); // 50MB max
      allow delete: if hasVerifiedEmail() && isOwner(userId);
    }
    
    // Event cover images — first path segment is owner uid (see app/api/upload/route.ts)
    match /events/{userId}/covers/{fileName} {
      allow read: if true; // Public read
      allow write: if hasVerifiedEmail() &&
        request.auth.uid == userId &&
        isValidImageType() && 
        isValidFileSize(5 * 1024 * 1024); // 5MB max
      allow delete: if hasVerifiedEmail() && request.auth.uid == userId;
    }
    
    // Report attachments — first path segment is reporter uid
    match /reports/{userId}/attachments/{fileName} {
      allow read: if false; // Only admins can read
      allow write: if hasVerifiedEmail() &&
        request.auth.uid == userId &&
        (isValidImageType() || isValidDocumentType()) && 
        isValidFileSize(10 * 1024 * 1024); // 10MB max
      allow delete: if hasVerifiedEmail() && request.auth.uid == userId;
    }
    
    // Workspace brand assets (logos / thumbnail templates)
    // Path: users/{uploaderUid}/workspaceBrandAssets/{workspaceId}/{fileName}
    match /users/{userId}/workspaceBrandAssets/{workspaceId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if hasVerifiedEmail() && isOwner(userId) &&
        isValidImageType() &&
        isValidFileSize(5 * 1024 * 1024);
      allow delete: if hasVerifiedEmail() && isOwner(userId);
    }
    
    // Public assets
    match /public/{fileName} {
      allow read: if true; // Public read
      allow write: if false; // Only server-side uploads
    }
    
    // Admin uploads
    match /admin/{fileName} {
      allow read, write: if false; // Only server-side access
    }
    
    // System files
    match /system/{fileName} {
      allow read, write: if false; // Only server-side access
    }
    
    // Temporary uploads (for processing)
    match /temp/{userId}/{fileName} {
      allow read, delete: if hasVerifiedEmail() && isOwner(userId);
      allow create, update: if hasVerifiedEmail() && isOwner(userId) && 
        (isValidImageType() || isValidVideoType() || isValidAudioType()) && 
        isValidFileSize(100 * 1024 * 1024); // 100MB max
    }

    // --- Flutter mobile paths (merged 2026-08-10; do not deploy until freeze lifted) ---

    // Draft assets (Flutter draft sharing / Tippy drafts)
    match /draft_assets/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if hasVerifiedEmail() && isOwner(userId) &&
        (isValidImageType() || isValidVideoType() || isValidAudioType()) &&
        isValidFileSize(250 * 1024 * 1024);
      allow delete: if hasVerifiedEmail() && isOwner(userId);
    }

    // Shared content library (authenticated media)
    match /content/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if hasVerifiedEmail() && isOwner(userId) &&
        (isValidImageType() || isValidVideoType() || isValidAudioType()) &&
        isValidFileSize(250 * 1024 * 1024);
      allow delete: if hasVerifiedEmail() && isOwner(userId);
    }

    // Public thumbnails
    // Legacy flat thumbnails/{videoId}.jpg — create-only so nobody can overwrite another user's file
    match /thumbnails/{fileName} {
      allow read: if true;
      allow create: if hasVerifiedEmail() &&
        isValidImageType() &&
        isValidFileSize(10 * 1024 * 1024);
    }

    match /thumbnails/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if hasVerifiedEmail() && isOwner(userId) &&
        isValidImageType() &&
        isValidFileSize(10 * 1024 * 1024);
      allow delete: if hasVerifiedEmail() && isOwner(userId);
    }

    // Flutter root videos/{userId}/… — public read (Mux may still be primary playback)
    match /videos/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if hasVerifiedEmail() && isOwner(userId) &&
        isValidVideoType() &&
        isValidFileSize(750 * 1024 * 1024);
      allow delete: if hasVerifiedEmail() && isOwner(userId);
    }

    // Chat attachments — participant-only
    match /chats/{chatId}/{allPaths=**} {
      allow read, write: if isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/chats/$(chatId)) &&
        request.auth.uid in
          firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
    }
  }
}
