rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read and write their own notifications
    match /notifications/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Users can read and write notification items
      match /items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Users can read and write their own relationships
    match /relationships/{relationshipId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.followerId || 
         request.auth.uid == resource.data.followingId);
    }
    
    // Users can read public user profiles
    match /users/{userId} {
      allow read: if request.auth != null;
    }
    
    // Users can read public posts
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.authorId;
    }
    
    // Users can read public comments
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.authorId;
    }
    
    // Users can read and write video comments
    match /videos/{videoId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.uid == resource.data.user.id || 
         request.auth.uid == request.resource.data.user.id);
    }
    
    // Users can read public videos
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.creator.id;
    }
    
    // Users can read public likes
    match /likes/{likeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Users can read public follows
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.followerId;
    }
    
    // Users can write their own engagement analytics
    match /engagement_analytics/{analyticsId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}