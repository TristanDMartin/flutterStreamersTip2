rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  // Users can read public user profiles and write their own
  match /users/{userId} {
    // Allow unauthenticated reads for username lookups during login
    allow read: if true;
    // Block self-escalation / ban bypass; privileged fields only via Admin SDK / Functions
    allow write: if request.auth != null && request.auth.uid == userId 
      && (!request.resource.data.keys().hasAny(['pinnedVideoIds']) 
          || request.resource.data.pinnedVideoIds.size() <= 3)
      && (
        !exists(/databases/$(database)/documents/users/$(userId))
          ? !request.resource.data.keys().hasAny([
              'role', 'isAdmin', 'admin', 'accountStatus',
              'bannedAt', 'bannedBy', 'banReason', 'adminNotes'
            ])
          : !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'role', 'isAdmin', 'admin', 'accountStatus',
              'bannedAt', 'bannedBy', 'banReason', 'adminNotes'
            ])
      );
      
      // TikTok-style: Allow any authenticated user to update follower/following counts and liked_videos array
      allow update: if request.auth != null 
        && (request.auth.uid == userId  // Own profile
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liked_videos', 'followingCount', 'followersCount', 'followerCount', 'connectionsCount']) // Only these fields
                && (!('liked_videos' in request.resource.data.diff(resource.data).affectedKeys()) 
                    || isValidBookmarkUpdate(request.resource.data.liked_videos)))); // Validate bookmark data only if liked_videos is being updated

      // Presence: any signed-in user can read (avatars / network); only owner writes
      match /presence/{presenceDocId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Users can read and write their own subcollections
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Explicit favorites rule for mobile/web bookmark persistence
      match /favorites/{videoId} {
        allow read, list: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }
      
      // Allow following/followers subcollections for authenticated users
      match /following/{followingId} {
        allow read, list: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == followingId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      
      match /followers/{followerId} {
        allow read, list: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == followerId
          && request.resource.data.userId == followerId;
        allow delete: if request.auth != null &&
          (request.auth.uid == followerId || request.auth.uid == userId);
      }
    }
    
    // Users can read their own notifications and write notifications for others
    match /notifications/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /items/{itemId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow list: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null &&
          (request.auth.uid == userId ||
           request.auth.uid == request.resource.data.user.id);
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Activity notifications (new structure for web/mobile parity)
    match /activity/{userId} {
      allow read, get: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      
      match /notifications/{notificationId} {
        allow read, get: if request.auth != null && request.auth.uid == userId;
        allow list: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null &&
          (request.auth.uid == userId ||
           request.auth.uid == request.resource.data.user.id);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Users can read and write their own relationships
    match /relationships/{relationshipId} {
      // Allow creating new relationships where user is the follower
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.followerId;
      
      // Allow reading relationships where user is involved
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.followerId || 
         request.auth.uid == resource.data.followingId);
      
      // Allow querying/listing relationships for authenticated users
      allow list: if request.auth != null;
      
      // Allow deleting relationships where user is the follower
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.followerId;
    }
    
    // Users can read public posts
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.authorId;
    }
    
    // Users can read public comments
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        (request.auth.uid == resource.data.authorId || 
         request.auth.uid == resource.data.commenterId);
    }
    
    // Users can read and write video comments
    match /videos/{videoId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        isNotBannedUser() &&
        request.auth.uid == request.resource.data.user.id &&
        (isUserAdmin() || isWithinCommentLimit(request.auth.uid));
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.user.id || 
         // Allow adding replies to any comment
         request.resource.data.keys().hasAll(['replies']) && 
         request.resource.data.replies is list);
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.user.id;
    }
    
    // Allow querying video comments collection
    match /videos/{videoId}/comments {
      allow list: if request.auth != null;
    }
    
    // Users can read public videos (Worker migration: no non-owner writes)
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && isNotBannedUser()
        && request.resource.data.userId == request.auth.uid;
      // Owner can update metadata after upload (Worker sets muxPlaybackId/hlsUrl/status:ready)
      // Viewers may only bump favorite counters (UnifiedBookmarkService batch).
      allow update: if request.auth != null
        && isNotBannedUser()
        && (
          (
            isVideoDocumentOwner()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'caption','hashtags','privacy','visibility','allowComments',
                'category','categoryId','category_id','categories',
                'updatedAt','deletedAt',
                'thumbnailUrl',
                'thumbnails','status','moderation','metadata','videoUrl',
                'visible','isReadyForFeed',
                'uploadError','errorMessage',
                'sourcePlatform','isMux','muxStatus','muxUploadId',
                'views','likes','comments','shares','favorites',
                'favoriteCount','id',
                'cross_platform_sharing','watermark_applied','moderation_confidence',
                'moderation_checked_at','duration','fileSize'
              ])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
                || request.resource.data.status != 'ready')
          )
          || isBookmarkFavoriteCountOnlyUpdate()
        );
      allow delete: if request.auth != null && isVideoDocumentOwner();
    }
    
    // User favorites collections
    match /user_favorites/{userId}/videos/{videoId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User videos collection - allows users to manage their own video posts
    match /user_videos/{userId} {
      // Users can read and write their own user_videos document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Posts subcollection - users can manage their own video posts
      match /posts/{videoId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow list: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // Allow other subcollections under user_videos
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Users can read public likes and write their own likes
    match /likes/{videoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (isUserAdmin() || isWithinLikeLimit(request.auth.uid));
      
      // Allow subcollections for user-specific likes
      match /byUser/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Users can read public follows and write their own follow relationships
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        followFollowerId() is string &&
        followTargetId() is string &&
        followFollowerId() != '' &&
        followTargetId() != '' &&
        request.auth.uid != followTargetId() &&
        request.auth.uid == followFollowerId() &&
        followId == followFollowerId() + '_' + followTargetId() &&
        request.resource.data.isActive == true &&
        (isUserAdmin() || isWithinFollowLimit(request.auth.uid));
      allow update: if request.auth != null &&
        (exists(/databases/$(database)/documents/follows/$(followId))
          ? request.auth.uid == existingFollowFollowerId() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isActive', 'updatedAt'])
          : false);
      allow delete: if request.auth != null &&
        (exists(/databases/$(database)/documents/follows/$(followId))
          ? request.auth.uid == existingFollowFollowerId()
          : false);
      allow list: if request.auth != null;
    }

    // User blocks - users can manage their own block edges and read any edge
    // they participate in.
    match /user_blocks/{blockId} {
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.blockerId;
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.blockerId ||
         request.auth.uid == resource.data.blockedUserId);
      allow list: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.blockerId;
    }
    
    // Users can read all engagement analytics and write their own
    match /engagement_analytics/{analyticsId} {
      allow read, list: if request.auth != null;
      allow create: if isRequestOwner();
      allow update, delete: if isResourceOwner();
    }
    
    // TikTok-style: Engagement tracking for algorithm
    match /engagement/{engagementId} {
      allow read: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if isRequestOwner();
      allow update, delete: if isResourceOwner();
    }
    
    // TikTok-style: User retention profiles for algorithm
    match /user_retention_profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read and write chats they participate in
    match /chats/{chatId} {
      // Allow creating new chats if the user is a participant
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.participants;
      
      // Allow reading and updating existing chats if the user is a participant
      allow read, update: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      // Allow listing chats for authenticated users
      allow list: if request.auth != null;
      
      // Allow deleting chats if the user is a participant
      allow delete: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      // Users can read and write messages in chats they participate in
      match /messages/{messageId} {
        // Allow reading messages if user is a participant in parent chat
        allow read: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // Allow listing messages if user is a participant in parent chat
        allow list: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // Allow creating messages only when the signed-in participant is the sender.
        allow create: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          isChatMessageSender();
        
        // Allow updating messages if user is a participant (for read receipts)
        allow update: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // Allow deleting messages if user is the sender (use 'from' field)
        allow delete: if request.auth != null && 
          request.auth.uid == resource.data.from;
      }
    }
    
    // Note: All user subcollections are now handled by the wildcard pattern above
    // This includes: bookmarks, deviceTokens, bookmarkedEvents, presence, videos, 
    // followers, following, likedVideos, connections, and any future subcollections
    
    // Hashtag permissions - allow authenticated users to read and write
    match /hashtag_permissions/{hashtag} {
      allow read: if request.auth != null;
      allow write: if isUserAdmin();
    }
    
    // Shared drafts permissions - allow users to read and write their own drafts
    match /shared_drafts/{draftId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.sharerId ||
         request.auth.uid == resource.data.senderId ||
         request.auth.uid in resource.data.recipients ||
         request.auth.uid == resource.data.receiverId);
      allow list: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.sharerId;
      allow update, delete: if request.auth != null && 
        (request.auth.uid == resource.data.sharerId ||
         request.auth.uid in resource.data.recipients ||
         request.auth.uid == resource.data.receiverId);
    }
    
    // Video analytics permissions - allow users to read and write their own analytics
    match /video_analytics/{videoId} {
      allow read: if request.auth != null;
      allow create: if isRequestOwner() || isAnalyticsCounterCreate();
      allow update: if isResourceOwner() || isAnalyticsCounterWrite();
      allow delete: if isResourceOwner();
    }

    // Creator Command / growth aggregates — owner read-write; admins read
    match /creator_metrics/{creatorId} {
      allow read: if request.auth != null && (
        request.auth.uid == creatorId || isUserAdmin());
      allow create, update: if request.auth != null &&
        request.auth.uid == creatorId;
      allow delete: if false;
    }

    match /support_tickets/{ticketId} {
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      allow read, list: if request.auth != null &&
        (isUserAdmin() || request.auth.uid == resource.data.userId);
      allow update, delete: if isUserAdmin();
    }

    match /forumCategories/{categoryId} {
      allow read, list: if request.auth != null;
      allow update: if isUserAdmin();
      allow create, delete: if isUserAdmin();
    }

    match /forumPosts/{postId} {
      allow read, list: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.authorId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        isUserAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likedBy','likes','bookmarkedBy','followedBy','commentCount',
          'updatedAt','reportCount','lastReported','commentReportCount'
        ])
      );
      allow delete: if false;

      match /comments/{commentId} {
        allow read, list: if request.auth != null;
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.authorId;
        allow update: if request.auth != null && (
          request.auth.uid == resource.data.authorId ||
          isUserAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likedBy','likes','dislikedBy','dislikes','replyCount',
            'deleted','content','updatedAt'
          ])
        );
        allow delete: if false;
      }
    }

    match /forumNotifications/{notificationId} {
      allow read, list: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read'
        ]);
      allow delete: if false;
    }
    
    // Video analytics aggregated data (camelCase) - read by InsightsView
    match /videoAnalytics/{videoId} {
      allow read: if request.auth != null;
      allow create: if isRequestOwner() || isAnalyticsCounterCreate();
      allow update: if isResourceOwner() || isAnalyticsCounterWrite();
      allow delete: if isResourceOwner();
    }
    
    // Video insights (additional insights data)
    match /videoInsights/{videoId} {
      allow read: if request.auth != null;
      allow create: if isRequestOwner() || isAnalyticsCounterCreate();
      allow update: if isResourceOwner() || isAnalyticsCounterWrite();
      allow delete: if isResourceOwner();
    }
    
    // Follow edges permissions - allow users to read and write their own follow relationships
    match /followEdges/{edgeId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.followerId || 
         request.auth.uid == resource.data.followingId);
      allow write: if request.auth != null && 
        request.auth.uid == request.resource.data.followerId;
      // Allow querying followEdges collection for relationship state
      allow list: if request.auth != null;
    }
    
    // Outgoing invites permissions - allow users to read and write their own invites
    match /users/{userId}/outgoingInvites/{inviteId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Incoming invites permissions - allow users to read invites sent to them
    match /users/{userId}/incomingInvites/{inviteId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Feed permissions - allow authenticated users to read and write feeds
    match /feeds/{feedType} {
      allow read: if request.auth != null;
      allow create: if isRequestOwner();
      allow update, delete: if isResourceOwner();

      match /videos/{videoId} {
        allow read, list: if request.auth != null;
        allow create: if isRequestOwner();
        allow update, delete: if isResourceOwner();
      }
      
      // Allow subcollections within feeds
      match /{subcollection=**} {
        allow read: if request.auth != null;
        allow create: if isRequestOwner();
        allow update, delete: if isResourceOwner();
      }
    }
    
    // Bookmark audit logging - allow users to create audit entries for their own actions
    match /bookmark_audit/{auditId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Feed telemetry written by Home feed impressions/play-start/skip logging
    match /feedSkipLogs/{logId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow read, list: if request.auth != null
        && (request.auth.uid == resource.data.userId || isUserAdmin());
      allow update, delete: if false;
    }
    
    // Rate limiting collection - for tracking operation frequency
    match /rate_limits/{userId} {
      // Users can read their own rate limit data
      allow read: if request.auth != null && request.auth.uid == userId;
      // System can write rate limit data (for server-side rate limiting)
      // Users can also write their own rate limit data (for client-side tracking)
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        isUserAdmin()
      );
    }
    
    // Creator stats - analytics data for content creators
    match /creator_stats/{userId} {
      // Allow reading your own stats or public stats
      allow read: if request.auth != null;
      allow list: if request.auth != null;
      // Allow writing your own stats
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
      
      // Follower history subcollection
      match /follower_history/{entryId} {
        allow read: if request.auth != null;
        allow list: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // Video stats subcollection
      match /video_stats/{entryId} {
        allow read: if request.auth != null;
        allow list: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // Allow other subcollections
      match /{subcollection=**} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Invites - user invitation system
    match /invites/{inviteId} {
      // Allow reading all invites for authenticated users
      allow read: if request.auth != null;
      allow list: if request.auth != null;
      // Allow creating invites
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.inviterId;
      // Allow updating invites - inviter or invitee can update
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.inviterId || 
         request.auth.uid == resource.data.inviteeId);
      // Allow deleting own invites
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.inviterId;
    }
    
    // Reports - content/user reporting system
    match /reports/{reportId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.reporterId ||
        isAdmin()
      );
      allow list: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.reporterId;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status', 'reviewedBy', 'reviewedAt', 'actionTaken', 'updatedAt'
          ]);
      allow delete: if false;
    }

    match /tippy_rate_limits/{rateLimitId} {
      allow read, write: if false;
    }

    match /tippy_usage_events/{eventId} {
      allow read, write: if false;
    }
    
    // Tags - user/content tagging system
    match /tags/{tagId} {
      // Anyone can read tags
      allow read: if request.auth != null;
      allow list: if request.auth != null;
      // Anyone can create tags
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.taggerId;
      // Can update your own tags
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.taggerId;
      // Can delete your own tags
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.taggerId;
    }
    
    // Mentions - user mention system
    match /mentions/{mentionId} {
      // Anyone can read mentions
      allow read: if request.auth != null;
      allow list: if request.auth != null;
      // Anyone can create mentions
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.mentionerId;
      // Can update your own mentions
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.mentionerId;
      // Can delete your own mentions
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.mentionerId;
    }
    
    // Moderation - content moderation system
    match /moderation/{moderationId} {
      // Only allow reading moderation data for the content owner
      allow read: if request.auth != null;
      allow list: if request.auth != null;
      // System can create moderation entries
      allow create: if isRequestOwner() || isUserAdmin();
      allow update, delete: if isResourceOwner();
    }
    
    // Admin logs - only admins can read/write
    match /admin_logs/{logId} {
      allow read: if isUserAdmin();
      allow create: if isUserAdmin();
      allow update, delete: if isUserAdmin();
    }
    
    // System settings - only admins can write
    match /system/{settingId} {
      allow read: if request.auth != null;
      allow write: if isUserAdmin();
    }
    
    // Admin notifications subcollection under users
    match /users/{userId}/admin_notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }
    
    // Device tokens subcollection (already exists but ensuring it's documented)
    match /users/{userId}/deviceTokens/{tokenId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User favorites subcollection
    match /user_favorites/{userId}/videos/{videoId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Conversations collection - for DM sharing
    match /conversations/{conversationId} {
      // Allow reading conversations if user is a participant
      allow read: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      // Allow creating conversations if user is a participant
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.participants;
      
      // Allow updating conversations if user is a participant
      allow update: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      // Allow listing conversations for authenticated users
      allow list: if request.auth != null;
      
      // Allow deleting conversations if user is a participant
      allow delete: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      // Messages subcollection
      match /messages/{messageId} {
        // Allow reading messages if user is a participant in parent conversation
        allow read: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        // Allow listing messages if user is a participant in parent conversation
        allow list: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        // Allow creating messages if user is the sender
        allow create: if request.auth != null && 
          request.auth.uid == request.resource.data.senderId;
        
        // Allow updating messages if user is a participant (for read receipts)
        allow update: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        // Allow deleting messages if user is the sender
        allow delete: if request.auth != null && 
          request.auth.uid == resource.data.senderId;
      }
    }
    
    // Scheduled posts collection - for video scheduling
    match /scheduled_posts/{scheduledPostId} {
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.authorId;
      allow list: if request.auth != null;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.authorId;
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.authorId;
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.authorId;
    }
  }
  
  // Video doc: bookmark / unbookmark by non-owner (client increment only).
  function videoIntField(data, field) {
    return field in data && data[field] is int ? data[field] : 0;
  }

  // Matches VideoActionsService owner resolution (userId, creatorId, creator_id).
  function isVideoDocumentOwner() {
    return request.auth != null
      && (
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        ('creatorId' in resource.data && resource.data.creatorId == request.auth.uid) ||
        ('creator_id' in resource.data && resource.data.creator_id == request.auth.uid)
      );
  }

  function isBookmarkFavoriteCountOnlyUpdate() {
    return request.auth != null
      && resource.data.keys().hasAll(['userId'])
      && request.auth.uid != resource.data.userId
      && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['favorites', 'favoriteCount', 'updatedAt'])
      && isFavoriteAndFavoriteCountStepTogether();
  }

  function isFavoriteAndFavoriteCountStepTogether() {
    let beforeF = videoIntField(resource.data, 'favorites');
    let afterF = videoIntField(request.resource.data, 'favorites');
    let beforeFC = videoIntField(resource.data, 'favoriteCount');
    let afterFC = videoIntField(request.resource.data, 'favoriteCount');
    return (afterF == beforeF + 1 && afterFC == beforeFC + 1)
      || (afterF == beforeF - 1 && afterFC == beforeFC - 1);
  }

  // Validation functions
  function isValidBookmarkUpdate(likedVideos) {
    return likedVideos is list
      && likedVideos.size() <= 1000  // Prevent abuse - max 1000 bookmarks
      && likedVideos.hasAll(['string'])  // Only video IDs allowed
      && likedVideos.size() == likedVideos.toSet().size();  // No duplicates
  }
  
  // Admin: JWT claim and/or Firestore on the signed-in user (self-writes
  // cannot set role/admin — see users/{userId} allow write).
  function isFirestoreAdminSelf() {
    let path = /databases/$(database)/documents/users/$(request.auth.uid);
    return exists(path)
      ? (
        ('role' in get(path).data && get(path).data.role == 'admin') ||
        ('isAdmin' in get(path).data && get(path).data.isAdmin == true) ||
        (
          'admin' in get(path).data &&
          get(path).data.admin is map &&
          get(path).data.admin.isAdmin == true
        )
      )
      : false;
  }

  function isAdmin() {
    return request.auth != null && (
      hasAdminClaim() ||
      isFirestoreAdminSelf()
    );
  }

  function isUserAdmin() {
    return isAdmin();
  }

  function hasAdminClaim() {
    return request.auth.token is map
      ? 'admin' in request.auth.token &&
        request.auth.token.admin == true
      : false;
  }

  function isNotBannedUser() {
    return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
      || !('accountStatus' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
      || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus != 'banned';
  }

  function requestOwnerId() {
    return 'userId' in request.resource.data
      ? request.resource.data.userId
      : ('ownerId' in request.resource.data
        ? request.resource.data.ownerId
        : ('authorId' in request.resource.data
          ? request.resource.data.authorId
          : ('creatorId' in request.resource.data
            ? request.resource.data.creatorId
            : ('viewerId' in request.resource.data
              ? request.resource.data.viewerId
              : ('likerId' in request.resource.data
                ? request.resource.data.likerId
                : ('commenterId' in request.resource.data
                  ? request.resource.data.commenterId
                  : ('sharerId' in request.resource.data
                    ? request.resource.data.sharerId
                    : ('uid' in request.resource.data
                      ? request.resource.data.uid
                      : null))))))));
  }

  function resourceOwnerId() {
    return 'userId' in resource.data
      ? resource.data.userId
      : ('ownerId' in resource.data
        ? resource.data.ownerId
        : ('authorId' in resource.data
          ? resource.data.authorId
          : ('creatorId' in resource.data
            ? resource.data.creatorId
            : ('viewerId' in resource.data
              ? resource.data.viewerId
              : ('likerId' in resource.data
                ? resource.data.likerId
                : ('commenterId' in resource.data
                  ? resource.data.commenterId
                  : ('sharerId' in resource.data
                    ? resource.data.sharerId
                    : ('uid' in resource.data
                      ? resource.data.uid
                      : null))))))));
  }

  function isRequestOwner() {
    return request.auth != null &&
      (request.auth.uid == requestOwnerId() || isUserAdmin());
  }

  function isResourceOwner() {
    return request.auth != null &&
      (request.auth.uid == resourceOwnerId() || isUserAdmin());
  }

  function isChatMessageSender() {
    return request.auth != null &&
      (
        ('from' in request.resource.data &&
          request.resource.data.from == request.auth.uid) ||
        ('senderId' in request.resource.data &&
          request.resource.data.senderId == request.auth.uid)
      );
  }

  function isAnalyticsCounterWrite() {
    return request.auth != null &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'views', 'likes', 'comments', 'shares', 'watchTime', 'watchTimeSeconds',
        'averageWatchTime', 'completionRate', 'engagementRate',
        'lastViewedAt', 'lastLikedAt', 'lastCommentedAt', 'lastSharedAt',
        'updatedAt', 'timestamp'
      ]);
  }

  function isAnalyticsCounterCreate() {
    return request.auth != null &&
      request.resource.data.keys().hasOnly([
        'views', 'likes', 'comments', 'shares', 'watchTime', 'watchTimeSeconds',
        'averageWatchTime', 'completionRate', 'engagementRate',
        'lastViewedAt', 'lastLikedAt', 'lastCommentedAt', 'lastSharedAt',
        'updatedAt', 'timestamp'
      ]);
  }
  
  function isWithinCommentLimit(userId) {
    return isUserAdmin() ||
           !exists(/databases/$(database)/documents/rate_limits/$(userId)) ||
           (!('comment_time' in get(/databases/$(database)/documents/rate_limits/$(userId)).data)) ||
           (request.time.seconds - get(/databases/$(database)/documents/rate_limits/$(userId)).data.comment_time.seconds > 60) ||
           (!('comment_count' in get(/databases/$(database)/documents/rate_limits/$(userId)).data)) ||
           (get(/databases/$(database)/documents/rate_limits/$(userId)).data.comment_count < 20);
  }
  
  function isWithinLikeLimit(userId) {
    return isUserAdmin() ||
           !exists(/databases/$(database)/documents/rate_limits/$(userId)) ||
           (!('like_time' in get(/databases/$(database)/documents/rate_limits/$(userId)).data)) ||
           (request.time.seconds - get(/databases/$(database)/documents/rate_limits/$(userId)).data.like_time.seconds > 60) ||
           (!('like_count' in get(/databases/$(database)/documents/rate_limits/$(userId)).data)) ||
           (get(/databases/$(database)/documents/rate_limits/$(userId)).data.like_count < 100);
  }
  
  function isWithinFollowLimit(userId) {
    let path = /databases/$(database)/documents/rate_limits/$(userId);
    return isUserAdmin() ||
           (!exists(path) ? true :
             (!('follow_time' in get(path).data)) ||
             (request.time.seconds - get(path).data.follow_time.seconds > 60) ||
             (!('follow_count' in get(path).data)) ||
             (get(path).data.follow_count < 30));
  }

  function followFollowerId() {
    return 'followerUserId' in request.resource.data
      ? request.resource.data.followerUserId
      : ('followerId' in request.resource.data
        ? request.resource.data.followerId
        : '');
  }

  function followTargetId() {
    return 'targetUserId' in request.resource.data
      ? request.resource.data.targetUserId
      : ('followingId' in request.resource.data
        ? request.resource.data.followingId
        : ('followedId' in request.resource.data
          ? request.resource.data.followedId
          : ''));
  }

  function existingFollowFollowerId() {
    return 'followerUserId' in resource.data
      ? resource.data.followerUserId
      : ('followerId' in resource.data
        ? resource.data.followerId
        : '');
  }
}
