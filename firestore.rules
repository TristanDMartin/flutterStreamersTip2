rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read and write their own notifications
    match /notifications/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Users can read and write notification items
      match /items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Users can read and write their own relationships
    match /relationships/{relationshipId} {
      // Allow creating new relationships where user is the follower
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.followerId;
      
      // Allow reading relationships where user is involved
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.followerId || 
         request.auth.uid == resource.data.followingId);
      
      // Allow deleting relationships where user is the follower
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.followerId;
    }
    
    // Users can read public user profiles
    match /users/{userId} {
      allow read: if request.auth != null;
    }
    
    // Users can read public posts
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.authorId;
    }
    
    // Users can read public comments
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.authorId;
    }
    
    // Users can read and write video comments
    match /videos/{videoId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.user.id;
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.user.id || 
         // Allow adding replies to any comment
         request.resource.data.keys().hasAll(['replies']) && 
         request.resource.data.replies is list);
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.user.id;
    }
    
    // Users can read public videos
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.creator.id;
    }
    
    // Users can read public likes
    match /likes/{likeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Users can read public follows
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.followerId;
    }
    
    // Users can write their own engagement analytics
    match /engagement_analytics/{analyticsId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Users can read and write chats they participate in
    match /chats/{chatId} {
      allow read, write: if request.auth != null && 
        request.auth.uid in resource.data.participants;
    }
    
    // Users can read and write messages in chats they participate in
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }
    
    // Users can read and write their own bookmarks
    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read and write their own device tokens for FCM
    match /users/{userId}/deviceTokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Legacy bookmarked events (for backward compatibility)
    match /users/{userId}/bookmarkedEvents/{bookmarkId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read and write their own presence status
    match /users/{userId}/presence/status {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read and write their own videos
    match /users/{userId}/videos/{videoId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read and write their own followers
    match /users/{userId}/followers/{followerId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read and write their own following
    match /users/{userId}/following/{followingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read and write their own liked videos
    match /users/{userId}/likedVideos/{videoId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read and write their own connections
    match /users/{userId}/connections/{connectionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read and write their own liked videos (alternative path)
    match /users/{userId}/likedVideos/{likeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}