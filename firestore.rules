rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read/write their own bookmarks
    match /bookmarks/{bookmarkId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    
    // Allow users to read/write their own platforms
    match /platforms/{platformId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    
    // Allow users to read/write their own posts
    match /posts/{postId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    
    // Allow users to read/write their own events
    match /events/{eventId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    
    // Allow users to read/write their own follows
    match /follows/{followId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.followerId || request.auth.uid == resource.data.followingId);
      allow create: if request.auth != null && 
        (request.auth.uid == request.resource.data.followerId || request.auth.uid == request.resource.data.followingId);
    }
    
    // Allow users to read/write relationships
    match /relationships/{relationshipId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.followerId || request.auth.uid == resource.data.followingId);
      allow create: if request.auth != null && 
        (request.auth.uid == request.resource.data.followerId || request.auth.uid == request.resource.data.followingId);
    }
    
    // Allow users to read/write their own profile
    match /users/{userId} {
      // Allow reading any user data (needed for username lookups during login)
      allow read: if true;
      // Allow users to write only their own data
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to read and write their own presence/status subcollection
      match /presence/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Allow users to read other users' presence status (for online status display)
    match /users/{userId}/presence/status {
      allow read: if request.auth != null;
    }
    
    // Username mapping collection for easier tracking
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
                   request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && 
                   request.auth.uid == request.resource.data.uid;
    }
    
    // Chat collection rules
    match /chats/{chatId} {
      allow read, write: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.participants;
    }
    
    // Messages subcollection rules
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      allow create: if request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }
  }
}