# Mux Video API credentials (from dashboard.mux.com → Settings → Access Tokens)
# Copy to .env and fill in your values. Do not commit .env.
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret

# Firebase (for migrate script: Firestore + Storage)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Tippy AI
# Production: set as a Firebase Functions secret instead of committing it:
# firebase functions:secrets:set ANTHROPIC_API_KEY --project streamerstip-6cfdb
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# Local emulator only. When true, localhost requests use deterministic mock Tippy replies.
TIPPY_DEV_MOCK=false

# Mobile IAP verifyMobilePurchase (set secrets in production; do not commit real values)
# Flutter: --dart-define=MOBILE_BILLING_VERIFY_URL=https://us-central1-PROJECT_ID.cloudfunctions.net/verifyMobilePurchase
APP_STORE_SHARED_SECRET=
# StoreKit 2 JWS verification (bundle must match iOS app)
APPLE_BUNDLE_ID=com.streamerstip.streamersTipApp
# Required for Production JWS checks (numeric App Store Connect app id)
APP_STORE_APP_APPLE_ID=
# One-line JSON for a Play Console–linked service account with Android Publisher API
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
ANDROID_PACKAGE_NAME=com.streamerstip.streamersTipApp
