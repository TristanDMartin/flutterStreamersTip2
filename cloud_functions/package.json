{
  "name": "streamers-tip-functions",
  "description": "Cloud Functions for StreamersTip bookmark notifications",
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "ensure:event-reminder-queue": "node scripts/ensure_event_reminder_queue.js",
    "logs": "firebase functions:log",
    "backfill:mux-feed-fields": "node scripts/backfill_mux_feed_fields.js",
    "migrate:legacy-video-comment-replies": "node scripts/migrate_legacy_video_comment_replies.js",
    "grant-admin-claims": "node scripts/grant_admin_claims.js",
    "reconcile:counters": "node reconcile_counters.js",
    "reconcile:counters:emulator": "cd .. && firebase emulators:exec --only firestore --project demo-follows-tests \"node cloud_functions/reconcile_counters.js\"",
    "test:progression": "cd .. && JAVA_HOME=/usr/local/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home PATH=/usr/local/opt/openjdk@21/bin:$PATH firebase emulators:exec --only firestore \"node cloud_functions/progression_callable_test.js\"",
    "test:rules:likes": "node likes_rules_test.js",
    "test:rules:interactions": "node interaction_rules_test.js",
    "test:rules:follows": "node follows_rules_test.js",
    "test:rules:videos": "node videos_rules_test.js",
    "test:rules:users-privacy": "cd .. && npx firebase-tools emulators:exec --only firestore --project demo-users-privacy \"node cloud_functions/users_privacy_rules_test.js\"",
    "test:e2e:follows": "node follows_e2e_test.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@apple/app-store-server-library": "^1.6.0",
    "@google-cloud/storage": "^7.7.0",
    "@google-cloud/tasks": "^5.5.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.0.1",
    "firebase-admin": "^11.8.0",
    "firebase-functions": "^4.3.1",
    "fluent-ffmpeg": "^2.1.2",
    "google-auth-library": "^9.14.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase": "^10.12.0",
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
