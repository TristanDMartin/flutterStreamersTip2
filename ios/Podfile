# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Set COCOAPODS_UPDATE_SPECS=true when a dependency update needs the trunk specs refreshed.
pre_install do |installer|
  next unless ENV['COCOAPODS_UPDATE_SPECS'] == 'true'

  system('pod repo update trunk')
end

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
require 'fileutils'

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  boring_ssl_privacy_manifest = File.join(
    installer.sandbox.root,
    'BoringSSL-GRPC',
    'src',
    'PrivacyInfo.xcprivacy'
  )
  unless File.exist?(boring_ssl_privacy_manifest)
    FileUtils.mkdir_p(File.dirname(boring_ssl_privacy_manifest))
    File.write(boring_ssl_privacy_manifest, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>NSPrivacyCollectedDataTypes</key>
        <array/>
        <key>NSPrivacyAccessedAPITypes</key>
        <array/>
        <key>NSPrivacyTracking</key>
        <false/>
      </dict>
      </plist>
    PLIST
  end

  grpc_endpoint_header_source = File.join(
    installer.sandbox.root,
    'gRPC-C++',
    'src',
    'core',
    'resolver',
    'endpoint_addresses.h'
  )
  grpc_endpoint_header_target = File.join(
    installer.sandbox.root,
    'gRPC-Core',
    'src',
    'core',
    'resolver',
    'endpoint_addresses.h'
  )
  if File.exist?(grpc_endpoint_header_source) && !File.exist?(grpc_endpoint_header_target)
    FileUtils.mkdir_p(File.dirname(grpc_endpoint_header_target))
    FileUtils.cp(grpc_endpoint_header_source, grpc_endpoint_header_target)
  end

  pod_warning_suppression = {
    'GCC_WARN_INHIBIT_ALL_WARNINGS' => 'YES',
    'GCC_TREAT_WARNINGS_AS_ERRORS' => 'NO',
    'SWIFT_TREAT_WARNINGS_AS_ERRORS' => 'NO',
    'CLANG_ANALYZER_NONNULL' => 'NO',
    'CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER' => 'NO',
    'CLANG_WARN_DOCUMENTATION_COMMENTS' => 'NO',
    'GCC_WARN_64_TO_32_BIT_CONVERSION' => 'NO',
    'CLANG_WARN_STRICT_PROTOTYPES' => 'NO',
    'GCC_WARN_DEPRECATED_FUNCTIONS' => 'NO',
    'GCC_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS' => 'NO',
    'GCC_WARN_DEPRECATED_IMPLEMENTATIONS' => 'NO',
    'GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS' => 'NO',
    'GCC_WARN_UNUSED_VARIABLE' => 'NO',
    'GCC_WARN_UNUSED_FUNCTION' => 'NO',
    'GCC_WARN_UNINITIALIZED_AUTOS' => 'NO',
    'CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS' => 'NO',
    'CLANG_WARN_DEPRECATED' => 'NO',
    'CLANG_WARN_UNUSED_VARIABLE' => 'NO',
    'SWIFT_SUPPRESS_WARNINGS' => 'YES',
    'OTHER_SWIFT_FLAGS' => '$(inherited) -suppress-warnings',
    'RUN_CLANG_STATIC_ANALYZER' => 'NO',
    'COMPILER_INDEX_STORE_ENABLE' => 'NO',
  }

  apply_warning_suppression = lambda do |config|
    pod_warning_suppression.each do |key, value|
      config.build_settings[key] = value
    end
    ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS'].each do |flag_key|
      flags = Array(config.build_settings[flag_key] || '$(inherited)')
      flags << '-w' unless flags.include?('-w')
      config.build_settings[flag_key] = flags
    end
  end

  installer.pods_project.build_configurations.each do |config|
    apply_warning_suppression.call(config)
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_phases.each do |phase|
      next unless phase.respond_to?(:name)
      next unless phase.name == 'Create Symlinks to Header Folders'

      phase.always_out_of_date = '1'
    end
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      apply_warning_suppression.call(config)
      if target.name == 'GoogleSignIn'
        header_search_paths = Array(config.build_settings['HEADER_SEARCH_PATHS'])
        header_search_paths << '$(inherited)'
        header_search_paths << '${PODS_ROOT}/AppCheckCore/AppCheckCore/Sources/Public'
        config.build_settings['HEADER_SEARCH_PATHS'] = header_search_paths.uniq
      end
    end
  end

  # Align Runner project-level settings so Xcode indexing doesn't surface pod noise.
  runner_project_path = File.join(__dir__, 'Runner.xcodeproj')
  if File.exist?(runner_project_path)
    runner_project = Xcodeproj::Project.open(runner_project_path)
    runner_project.build_configurations.each do |config|
      apply_warning_suppression.call(config)
    end
    runner_project.targets.each do |target|
      next unless target.name == 'RunnerTests'

      target.build_configurations.each do |config|
        apply_warning_suppression.call(config)
      end
    end
    runner_project.save
  end
end
