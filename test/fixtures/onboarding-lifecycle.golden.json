        "isPasswordProvider": false,
        "localTippyStage": "avatar",
        "isAuthenticated": true,
        "hasFirstGrowthPlan": false,
        "firstMissionChoice": null
      },
      "expected": {
        "lifecycle": "COMPLETE",
        "tippyStageHint": null,
        "allowApp": true,
        "reason": "sticky_complete",
        "activationState": "ACTIVATED"
      }
    },
