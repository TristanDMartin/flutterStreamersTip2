# Copy to `.env.release` (gitignored) and export before release builds.
# Never commit real secrets.
#
# Usage:
#   set -a && source .env.release && set +a
#   flutter build appbundle --release \
#     --dart-define=GIPHY_API_KEY="$GIPHY_API_KEY" \
#     --dart-define=MOBILE_BILLING_VERIFY_URL="$MOBILE_BILLING_VERIFY_URL" \
#     --dart-define=TIPPY_API_BASE="$TIPPY_API_BASE"

GIPHY_API_KEY=replace-with-giphy-api-key
MOBILE_BILLING_VERIFY_URL=https://us-central1-streamerstip-6cfdb.cloudfunctions.net/verifyMobilePurchase
TIPPY_API_BASE=
GIPHY_FALLBACK_API_KEY=
