# Copy to `.env.release` (gitignored) and export before release builds.
# Never commit real secrets.
#
# Canonical release (obfuscated + versioned symbols):
#   set -a && source .env.release && set +a
#   bash scripts/build_store_release.sh android
#
# Optional Crashlytics Dart symbol upload after build:
#   export FIREBASE_ANDROID_APP_ID=1:...:android:...
#   export FIREBASE_IOS_APP_ID=1:...:ios:...
#   bash scripts/upload_crashlytics_symbols.sh

GIPHY_API_KEY=replace-with-giphy-api-key
MOBILE_BILLING_VERIFY_URL=https://us-central1-streamerstip-6cfdb.cloudfunctions.net/verifyMobilePurchase
# Production email verification continue origin (environment-owned)
EMAIL_VERIFICATION_ORIGIN=https://streamerstip.com
SITE_API_BASE=https://streamerstip.com
TIPPY_API_BASE=
GIPHY_FALLBACK_API_KEY=
